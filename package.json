{
  "name": "ai-chess-tutor",
  "version": "0.1.0",
  "description": "LLM chess tutor with Chessnut Air support, UCI engines and live Stockfish analysis",
  "type": "module",
  "main": "out/main/index.js",
  "author": "Daniel Buch",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "fetch-engines": "node scripts/fetch-engines.mjs",
    "dist": "node scripts/dist.mjs",
    "setup": "node scripts/setup.mjs",
    "verify-engines": "node scripts/verify-engines.mjs",
    "verify-signature": "node scripts/verify-signature.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@google/genai": "^2.22.0",
    "@lichess-org/chessground": "^10.1.1",
    "chess.js": "^1.4.0",
    "i18next": "^26.4.2",
    "openai": "^7.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "de.dbuch.aichesstutor",
    "productName": "AI Chess Tutor",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/engines/${os}-${arch}",
        "to": "engines"
      }
    ],
    "mac": {
      "identity": "-",
      "category": "public.app-category.board-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Connect to your Chessnut chessboard to read moves and control its LEDs."
      }
    },
    "win": {
      "icon": "resources/icon.png",
      "extraResources": [
        {
          "from": ".",
          "to": "windows-runtime",
          "filter": ["setup-windows.ps1", "scripts/windows-runtime.json"]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Game",
      "maintainer": "Daniel Buch <dbuch-github@users.noreply.github.com>",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "ai-chess-tutor"
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnss3",
        "libasound2 | libasound2t64",
        "libgbm1",
        "libnotify4",
        "libxss1",
        "libxtst6",
        "libsecret-1-0",
        "xdg-utils",
        "libstdc++6",
        "zlib1g"
      ]
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
